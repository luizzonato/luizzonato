{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edla-financas",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/assetlinks.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edla-financas",
      // Troque pelo ID que o comando "wrangler d1 create edla-financas" mostrar.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "MAX_USERS": "2"
  }
}
